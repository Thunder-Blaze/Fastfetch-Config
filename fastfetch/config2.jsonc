{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/pngs/\" -name \"*.png\" | shuf -n 1)",
        "height": 30,
        "padding": {
            "left": 6,
            "right": 6
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[36m    コンピューター"
        },
        {
            "type": "custom",
            "format": "╔════════════════════════🟕═════════════════════════╗"
        },
        "break",
        {
            "type": "host",
            "key": "╭─    Host   ",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "├─  󰍹  Display",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "├─    CPU    ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": "├─    GPU    ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├─    Memory ",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "╰─    Disk   ",
            "keyColor": "green"
        },
        "break",
        {
            "type": "os",
            "key": "╭─    OS     ",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "├─    Kernel ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "├─    WM     ",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "├─    Package",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "├─    Uptime ",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "╰─  󱎫  OS Age ",
            "keyColor": "blue",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); echo $(((current-birth_install)/86400)) days"
        },
        "break",
        {
            "type": "command",
            "key": "╭─    Anilist    ",
            "keyColor": "magenta",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper anilist --color magenta);echo -e $a"
        },
        {
            "type": "command",
            "key": "├─  󰊤  Github     ",
            "keyColor": "magenta",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper github --color magenta);echo -e $a"
        },
        {
            "type": "command",
            "key": "├─  󰄨  CodeForces ",
            "keyColor": "magenta",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper codeforces --color magenta);echo -e $a"
        },
        {
            "type": "command",
            "key": "├─    LeetCode   ",
            "keyColor": "magenta",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper leetcode --color magenta);echo -e $a"
        },
        {
            "type": "command",
            "key": "├─    Instagram  ",
            "keyColor": "magenta",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper instagram --color magenta);echo -e $a"
        },
        {
            "type": "command",
            "key": "├─    Reddit     ",
            "keyColor": "blue",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper reddit --color blue);echo -e $a"
        },
        {
            "type": "command",
            "key": "├─    MyAnimeList",
            "keyColor": "magenta",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper myanimelist --color magenta);echo -e $a"
        },
        {
            "type": "command",
            "key": "├─    Twitter    ",
            "keyColor": "yellow",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper twitter --color yellow);echo -e $a"
        },
        {
            "type": "command",
            "key": "╰─  󰭼  Codechef   ",
            "keyColor": "magenta",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper codechef --color magenta);echo -e $a"
        },
        {
            "type": "command",
            "key": "╰─  󰄨  Simkl      ",
            "keyColor": "red",
            "text": "a=$(/home/$USER/.config/fastfetch/tsukiyomi-fetch wrapper simkl --color magenta);echo -e $a"
        },
        "break",
        {
            "type": "custom",
            "format": "╚════════════════════════🟕═════════════════════════╝"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "diamond"
        },
        "break"
    ]
}
